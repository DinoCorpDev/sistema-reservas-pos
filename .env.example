# Copy to .env (never committed to the repo).

# Cloud database (global source of truth) and local database of the location hub.
# Windows development (DEC-013): `pnpm mysql:start` runs MySQL 8 on 127.0.0.1:3310 with its data in
# .data/mysql (root, no password). With Docker Compose use ports 3306 (cloud) and 3307 (hub).
DATABASE_URL=mysql://root@127.0.0.1:3310/pos_cloud
HUB_DATABASE_URL=mysql://root@127.0.0.1:3310/pos_hub

# Backoffice password for the demo users with an email (optional; see packages/db/src/seed/data/restaurant.ts).
# SEED_ADMIN_PASSWORD=

# Secret for Auth.js sessions and POS tokens. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Location hub
HUB_PORT=4100
# HTTPS of the hub (DEC-028): on in production with a DNS zone (deploy/.env.example). Here the
# hub stays on http://localhost. HUB_LAN_IP overrides the LAN address the hub reports.
# HUB_DNS_ZONE=
# HUB_LAN_IP=

# Playwright browsers, relative to the repo root (keeps the download off C:). Leave unset in CI.
PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright
