# Copiar a .env (nunca se sube al repo).

# Base de la nube (fuente de verdad global) y base local del hub de la sede.
# Desarrollo con Laragon (DEC-002): MySQL 8 en 127.0.0.1:3306, usuario root sin contraseña.
# Con Docker Compose: HUB_DATABASE_URL apunta al puerto 3307.
DATABASE_URL=mysql://root@127.0.0.1:3306/pos_cloud
HUB_DATABASE_URL=mysql://root@127.0.0.1:3306/pos_hub

# Contraseña del backoffice para los usuarios demo con correo (opcional; ver packages/db/src/seed/data/restaurant.ts).
# SEED_ADMIN_PASSWORD=

# Hub de la sede
HUB_PORT=4100
