{
  "name": "@pos/api",
  "version": "0.0.0",
  "private": true,
  "description": "Application layer of the Core POS: use cases (services) and the public REST API v1 (Hono + OpenAPI)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude \"**/*.int.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "menu:import": "tsx src/scripts/import-menu.ts",
    "archive:loop": "tsx src/scripts/archive.ts loop",
    "archive:month": "tsx src/scripts/archive.ts month",
    "monitor": "tsx src/scripts/monitor.ts",
    "hub-certs:loop": "tsx src/scripts/hub-certificates.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@pos/core": "workspace:*",
    "@pos/db": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.10",
    "acme-client": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "nodemailer": "^7.0.13",
    "otplib": "^13.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pos/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
