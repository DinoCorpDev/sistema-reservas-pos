{
  "extends": "@pos/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "e2e/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", "src/sw"]
}
