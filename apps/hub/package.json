{
  "name": "@pos/hub",
  "version": "0.0.0",
  "private": true,
  "description": "Local node of the location: real-time over WebSocket on the LAN, ESC/POS printing and queue to the cloud",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "fake-printer": "tsx src/fake-printer-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@node-rs/argon2": "catalog:",
    "@pos/api": "workspace:*",
    "@pos/core": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.10",
    "@pos/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "mysql2": "catalog:",
    "otplib": "^13.5.0",
    "uuidv7": "catalog:",
    "ws": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pos/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
