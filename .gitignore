# dependencies
node_modules/
.pnpm-store/

# builds
.next/
dist/
out/
*.tsbuildinfo
next-env.d.ts
# hub runtime state: its device token and cursors (apps/hub/src/state.ts)
.hub-state.json
.hub-config.json
# service worker generated by Serwist at build time (source: apps/web/src/sw/sw.ts)
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/swe-worker-*.js

# monthly legal archive written locally by `archive:month` (deploy: the archive volume)
.archive/

# turbo / caches
.turbo/
.eslintcache
# local Playwright browsers (PLAYWRIGHT_BROWSERS_PATH) and local MySQL data (scripts/dev-mysql.ps1)
.cache/
.data/

# environment (never commit secrets)
.env
.env.*
!.env.example

# tests
coverage/
playwright-report/
test-results/
blob-report/

# system
.DS_Store
Thumbs.db
*.log
