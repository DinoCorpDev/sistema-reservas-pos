# Settings of the hub of one location (deploy/hub/docker-compose.yml). install-hub.sh writes
# deploy/hub/.env from this file; never commit it.

# The cloud this location belongs to, e.g. https://pos.example.ch
HUB_CLOUD_URL=
# Pairing code of the location's terminal of type «Hub» (backoffice → Geräte & Stationen).
# Used once; install-hub.sh removes it after pairing.
HUB_PAIRING_CODE=

# The hub's own database (random values from install-hub.sh).
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# false on a standby hub that must not number orders (docs/SYNC.md §11.4).
HUB_AUTHORITY=true
# Comma-separated origins of the POS allowed to call the hub; empty: any.
HUB_ALLOWED_ORIGINS=
HUB_PORT=4100
HUB_TLS_PORT=4443
# This PC's fixed address in the LAN (install-hub.sh detects it): the hub's DNS name points to it.
HUB_LAN_IP=
LOG_LEVEL=info
# Set by install-hub.sh from git (date + commit).
APP_VERSION=
