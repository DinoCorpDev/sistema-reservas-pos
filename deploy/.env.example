# Production settings of the cloud (deploy/docker-compose.prod.yml). Copy to deploy/.env.
# Never commit deploy/.env: it holds the secrets.

# ── Public address ─────────────────────────────────────────────────────────────
DOMAIN=pos.example.ch
ACME_EMAIL=ops@example.ch
# Set by deploy.sh from git (version + commit); devices and /health report it.
APP_VERSION=

# ── Database ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ── Auth ───────────────────────────────────────────────────────────────────────
# 32+ random bytes, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
AUTH_SECRET=
AUTH_URL=https://pos.example.ch
AUTH_TRUST_HOST=true

# ── Logs (RNF-18) ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_RETENTION_DAYS=90

# ── Alerts to support by e-mail (RNF-16) ───────────────────────────────────────
SUPPORT_ALERT_EMAIL=soporte@example.ch
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=POS Monitor <monitor@example.ch>
# Production expects hourly backups and alerts when they are missing; false on a test server.
MONITOR_EXPECT_BACKUPS=true

# ── HTTPS of the LAN hubs (DEC-028) ────────────────────────────────────────────
# Each hub gets h-<id>.<HUB_DNS_ZONE> → its LAN address and a Let's Encrypt certificate (DNS-01).
# Empty: the hubs stay on plain HTTP (only usable on the same PC, e.g. a test). The zone lives
# at Cloudflare (free); the API token needs «DNS edit» on that zone only.
HUB_DNS_ZONE=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# production, or staging while testing (untrusted certificates, generous limits).
ACME_DIRECTORY=production

# ── Backups (RNF-14): restic to an S3-compatible bucket in a Swiss region ──────
RESTIC_REPOSITORY=s3:https://s3.example.ch/pos-backups
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Minutes past the hour of the hourly backup, and the day of the monthly restore test.
BACKUP_MINUTE=17
RESTORE_TEST_DAY=1
